   "texts": [
    {
     "x": 40,
     "y": 785,
     "s": "USB1：Type-C 公头，插主控机 —— 整板唯一供电入口",
     "size": null,
     "bold": true
    },
    {
     "x": 40,
     "y": 770,
     "s": "UFP：CC 接 Rd 5.1k。SuperSpeed 触点不用。D1 第 5 脚悬空。",
     "size": null,
     "bold": false
    },
    {
     "x": 640,
     "y": 785,
     "s": "USB2：Type-C 母座，接被控机 —— 只做数据和 VBUS 检测",
     "size": null,
     "bold": true
    },
    {
     "x": 640,
     "y": 770,
     "s": "VBUS2 不进任何电源轨，不与 VBUS1 相连；CC1/CC2 各自 Rd 5.1k，不与 USB1 共用。",
     "size": null,
     "bold": false
    },
    {
     "x": 640,
     "y": 755,
     "s": "D2 第 5 脚故意悬空：D+/D- 没有二极管通路进入 VBUS2 检测点或 3V3。",
     "size": null,
     "bold": false
    },
    {
     "x": 40,
     "y": 580,
     "s": "CC 端接 + ESD",
     "size": null,
     "bold": true
    },
    {
     "x": 640,
     "y": 580,
     "s": "CC 端接 + ESD",
     "size": null,
     "bold": true
    },
    {
     "x": 40,
     "y": 462,
     "s": "电源：VBUS1 → PTC 0.5A → 肖特基 (阻断向 USB1 回灌) → LDO 3.3V",
     "size": null,
     "bold": true
    },
    {
     "x": 640,
     "y": 462,
     "s": "VBUS2 检测：100k/10k 分压 -> PC4 (ADC14)，固件用 ADC 读。VBUS2 上无储能电容",
     "size": null,
     "bold": true
    },
    {
     "x": 640,
     "y": 340,
     "s": "VBUS2 为 5V 时 PC4 约 0.45V，低于引脚保护二极管的导通电压：只接 USB2 时不会经 PC4 向 3V3 漏电。",
     "size": null,
     "bold": false
    },
    {
     "x": 640,
     "y": 325,
     "s": "滤波约 1ms (9.1k x 100nF)。整板只由 USB1 供电；固件在 VBUS2 有效后才使能 USB2 上拉。",
     "size": null,
     "bold": false
    }
   ],
