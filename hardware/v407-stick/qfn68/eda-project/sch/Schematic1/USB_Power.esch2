{"type":"TEXT","ticket":69985,"id":"9469e716ec780fed"}||{"x":640,"y":325,"rotation":0,"color":null,"fontFamily":null,"fontSize":null,"fontWeight":false,"italic":false,"underline":false,"align":"LEFT_BOTTOM","value":"滤波约 1ms (9.1k x 100nF)。整板只由 USB1 供电；固件在 VBUS2 有效后才使能 USB2 上拉。","fillColor":null,"zIndex":144,"yAxisDirection":"up"}